# PostgreSQL (docker-compose.yml postgres servisi bunu kullanır)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://radar:${POSTGRES_PASSWORD}@postgres:5432/radar

# anthropic (varsayılan) veya gemini. Sınıflandırma/çeviri/özet/sohbet bu
# sağlayıcıyı kullanır; sohbet isteğinde llm_provider/llm_api_key/llm_model
# alanlarıyla istek bazında geçersiz kılınabilir (docs/api.md).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5
# LLM_PROVIDER=gemini kullanılacaksa:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required in production: clients must send this as the X-API-Key header on
# every /api/* request. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Empty disables the check (local dev only).
API_KEY=

AUTO_SCAN_ENABLED=true
SCAN_TIMEZONE=Europe/Istanbul
SCAN_HOURS=6,10,14,18,22

# Minutes between scans; 0 uses SCAN_HOURS instead.
SCAN_INTERVAL_MINUTES=15
